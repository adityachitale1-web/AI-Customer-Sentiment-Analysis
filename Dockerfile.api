# Sentiment API — production image
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    SENTIMENT_DB_PATH=/data/feedback.db \
    SENTIMENT_MODEL_DIR=/app/2_Model/distilbert-sentiment

COPY requirements.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir transformers fastapi "uvicorn[standard]" pydantic

COPY 3_API/ ./3_API/
COPY 4_Database/db.py ./4_Database/db.py
COPY 2_Model/ ./2_Model/

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

WORKDIR /app/3_API
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
