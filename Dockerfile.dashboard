# Sentiment dashboard — production image
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    SENTIMENT_DB_PATH=/data/feedback.db

RUN pip install --no-cache-dir streamlit plotly pandas requests

COPY 5_Dashboard/ ./5_Dashboard/
COPY 4_Database/db.py ./4_Database/db.py

EXPOSE 8501
WORKDIR /app/5_Dashboard
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
