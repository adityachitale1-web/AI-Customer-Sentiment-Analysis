# CXSentinel secrets template
# ---------------------------
# Copy this file to secrets.toml (same folder), fill in ONE of the two options
# below, and restart the dashboard. secrets.toml is gitignored — it never
# reaches GitHub.
#
# With either option configured, verification codes/links are ACTUALLY EMAILED,
# so a mistyped mailbox (e.g. aditchitale1@gmail.com) never receives the code
# and can never activate an account.

# --- Option A: Gmail SMTP (verification codes emailed by the app) -----------
# 1. Go to https://myaccount.google.com/apppasswords  (needs 2-Step Verification on)
# 2. Create an app password named "CXSentinel" and copy the 16-character code
# 3. Fill in below and remove the leading '#' from each line

# [smtp]
# host = "smtp.gmail.com"
# port = 587
# user = "adityachitale1@gmail.com"
# password = "xxxx xxxx xxxx xxxx"   # the 16-char app password, NOT your Gmail password
# from = "adityachitale1@gmail.com"

# --- Option B: Supabase Auth (Supabase sends the confirmation links) --------
# 1. Create a free project at https://supabase.com/dashboard
# 2. Project Settings -> API: copy the Project URL and the anon public key

# [supabase]
# url = "https://YOUR-PROJECT-REF.supabase.co"
# anon_key = "eyJ..."

# --- Optional: override the master (owner) account ---------------------------
# [master]
# email = "adityachitale1@gmail.com"
# password = "choose-a-strong-password"
