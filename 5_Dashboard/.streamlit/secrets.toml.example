# CXSentinel secrets template
# ---------------------------
# Copy to secrets.toml (same folder) and fill in. secrets.toml is gitignored.

# =====================================================================
#  REAL "Sign in with Google" (account chooser + redirect) — OIDC
# =====================================================================
# When this [auth] block is present, the "Continue With Google" button
# redirects to Google's real account-picker instead of the demo email box.
#
# HOW TO GET THE VALUES (one-time, ~5 min, in YOUR Google account):
#   1. Go to https://console.cloud.google.com/  ->  create a project
#      (or pick one). APIs & Services -> OAuth consent screen -> set it up
#      as "External", add your email as a Test user.
#   2. APIs & Services -> Credentials -> Create Credentials
#      -> OAuth client ID -> Application type: "Web application".
#   3. Under "Authorized redirect URIs" add BOTH of these:
#          http://localhost:8501/oauth2callback
#          https://YOUR-APP-NAME.streamlit.app/oauth2callback
#      (the second one is your hosted URL; add it so Google works there too)
#   4. Click Create. Copy the "Client ID" and "Client secret".
#   5. Fill them in below and remove the leading '#' from each line.
#
# cookie_secret: any long random string you invent (32+ characters).

# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "PUT-ANY-LONG-RANDOM-STRING-HERE-AT-LEAST-32-CHARS"
# client_id = "xxxxxxxx.apps.googleusercontent.com"
# client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Optional: override the master (owner) account ---------------------------
# [master]
# email = "adityachitale1@gmail.com"
# password = "choose-a-strong-password"
